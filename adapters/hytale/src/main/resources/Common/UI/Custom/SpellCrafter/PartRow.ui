// One part's title in the editor ("2. resist"), with Up, Down and Remove. Its fields follow as rows of
// their own. The buttons' text is fixed here.
$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 36, Top: 8, Bottom: 4);
  Background: #1d2a3a(0.6);
  Padding: (Horizontal: 8);

  Label #Label {
    Text: "";
    FlexWeight: 1;
    Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
  }

  $C.@SmallSecondaryTextButton #Up {
    @Text = "Up";
    @Anchor = (Width: 56, Top: 4, Left: 4);
    Padding: (Horizontal: 0);
  }

  $C.@SmallSecondaryTextButton #Down {
    @Text = "Down";
    @Anchor = (Width: 68, Top: 4, Left: 4);
    Padding: (Horizontal: 0);
  }

  $C.@SmallSecondaryTextButton #Del {
    @Text = "Remove";
    @Anchor = (Width: 84, Top: 4, Left: 4);
    Padding: (Horizontal: 0);
  }
}
